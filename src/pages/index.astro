---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

// Load all gallery images recursively from src/assets/gallery/ and subfolders
const galleryModules = import.meta.glob('../assets/gallery/**/*.{jpg,jpeg,png,webp,JPG,PNG}', { eager: true });

// Parse category tag from subfolder path
const galleryFiles = Object.entries(galleryModules).map(([path, module]: [string, any]) => {
  const parts = path.split('/');
  parts.pop(); // remove filename
  const folder = parts.pop()?.toLowerCase();

  const category = (folder === 'gallery' || !folder) ? 'all' : folder;

  return {
    img: module.default,
    category: category
  };
});
---

<Layout title="Karl's Gallery">
  <div class="bg-white min-h-screen text-black font-sans">
    
    <!-- HEADER -->
    <header class="flex justify-between items-start px-4 pt-5 pb-3 md:px-8 max-w-7xl mx-auto">
      <div class="overflow-hidden pr-4">
        <h1 class="text-[17px] md:text-2xl font-bold uppercase tracking-wide text-gray-900 truncate">
          PORTFOLIO TEST NI KARL
        </h1>
        <p class="text-[10px] md:text-xs text-gray-400 uppercase tracking-[0.15em] mt-1">
          Karl's Gallery
        </p>
      </div>

      <!-- ICONS -->
      <div class="flex items-center gap-4 text-gray-900 shrink-0 mt-1">
        <button aria-label="Favorite" class="hover:opacity-70 transition-opacity cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 md:w-7 md:h-7">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
          </svg>
        </button>
        <button id="open-contact-modal" aria-label="More options" class="hover:opacity-70 transition-opacity cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 md:w-7 md:h-7">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a.75.75 0 110-1.5.75.75 0 010 1.5zM12 12.75a.75.75 0 110-1.5.75.75 0 010 1.5zM12 18.75a.75.75 0 110-1.5.75.75 0 010 1.5z" />
          </svg>
        </button>
      </div>
    </header>

    <!-- CLEAN CATEGORY FILTER BUTTONS -->
    <nav class="max-w-7xl mx-auto px-4 md:px-8 mb-4">
      <div class="flex items-center gap-2 overflow-x-auto pt-1 pb-2 no-scrollbar" id="filter-buttons">
        <button 
          data-filter="all" 
          class="filter-btn active px-4 py-1.5 rounded-full text-[11px] uppercase tracking-wider font-semibold bg-black text-white transition-all cursor-pointer whitespace-nowrap"
        >
          All
        </button>
        <button 
          data-filter="sports" 
          class="filter-btn px-4 py-1.5 rounded-full text-[11px] uppercase tracking-wider font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 hover:text-black transition-all cursor-pointer whitespace-nowrap"
        >
          Sports
        </button>
        <button 
          data-filter="wedding" 
          class="filter-btn px-4 py-1.5 rounded-full text-[11px] uppercase tracking-wider font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 hover:text-black transition-all cursor-pointer whitespace-nowrap"
        >
          Weddings
        </button>
        <button 
          data-filter="events" 
          class="filter-btn px-4 py-1.5 rounded-full text-[11px] uppercase tracking-wider font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 hover:text-black transition-all cursor-pointer whitespace-nowrap"
        >
          Events
        </button>
      </div>
    </nav>

    <!-- PIXIESET STYLE GRID -->
    <main class="max-w-7xl mx-auto px-1 md:px-4 pb-20">
      {galleryFiles.length === 0 ? (
        <div class="text-center py-20 text-gray-500">
          No images found yet. Add photos into src/assets/gallery/
        </div>
      ) : (
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-1" id="gallery-container">
          {galleryFiles.map((item: any, index: number) => (
            <div 
              data-category={item.category}
              class="w-full relative cursor-pointer gallery-item group overflow-hidden"
            >
              <Image 
                src={item.img} 
                alt={`Gallery photo ${index + 1}`}
                class="w-full h-full object-cover aspect-[3/2] group-hover:opacity-90 transition-opacity duration-300"
              />
            </div>
          ))}
        </div>
      )}
    </main>
  </div>

  <!-- LIGHTBOX MODAL -->
  <div 
    id="lightbox" 
    class="fixed inset-0 z-50 hidden bg-white/95 backdrop-blur-md flex items-center justify-center p-4 transition-opacity duration-300 opacity-0"
  >
    <button 
      id="lightbox-close" 
      class="absolute top-6 right-6 text-black text-3xl font-light hover:opacity-50 transition-opacity z-50 p-2 cursor-pointer"
      aria-label="Close"
    >
      ✕
    </button>
    <img 
      id="lightbox-img" 
      src="" 
      alt="Enlarged view" 
      class="max-h-[90vh] max-w-[90vw] object-contain shadow-2xl transition-transform duration-300 scale-95"
    />
  </div>

  <!-- MENU / CONTACT MODAL -->
  <div 
    id="contact-modal" 
    class="fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-end md:items-center justify-center p-0 md:p-4 transition-all duration-300 opacity-0 pointer-events-none"
  >
    <div 
      id="contact-modal-card" 
      class="bg-white rounded-t-3xl md:rounded-2xl w-full max-w-md p-8 text-center relative transform transition-all duration-300 translate-y-full md:translate-y-0 md:scale-95 opacity-0 shadow-2xl"
    >
      <button 
        id="close-contact-modal" 
        class="absolute top-5 right-5 text-gray-400 hover:text-black text-lg transition-colors cursor-pointer"
        aria-label="Close modal"
      >
        ✕
      </button>

      <h2 class="text-xl font-bold tracking-wide mb-6 text-black uppercase">Menu</h2>

      <div class="space-y-3">
        <!-- Facebook Link -->
        <a 
          href="https://www.facebook.com/profile.php?id=61593356425555" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="flex items-center justify-between p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition-all duration-300 group text-left border border-gray-100"
        >
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-lg">
              f
            </div>
            <div>
              <p class="text-sm font-semibold text-gray-900">Karl's Gallery</p>
              <p class="text-[10px] text-gray-500 uppercase tracking-wider">Facebook Page</p>
            </div>
          </div>
        </a>

        <!-- Email Link -->
        <a 
          href="mailto:karlsgallery6@gmail.com" 
          class="flex items-center justify-between p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition-all duration-300 group text-left border border-gray-100"
        >
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-gray-200 text-gray-600 flex items-center justify-center text-sm">
              ✉️
            </div>
            <div>
              <p class="text-sm font-semibold text-gray-900">Contact</p>
              <p class="text-[10px] text-gray-500 uppercase tracking-wider">karlsgallery6@gmail.com</p>
            </div>
          </div>
        </a>

        <!-- Share Button -->
        <button 
          id="share-btn" 
          class="w-full flex items-center justify-between p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition-all duration-300 group text-left border border-gray-100 cursor-pointer"
        >
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-gray-200 text-gray-600 flex items-center justify-center text-sm">
              🔗
            </div>
            <div>
              <p class="text-sm font-semibold text-gray-900">Share Gallery</p>
              <p class="text-[10px] text-gray-500 uppercase tracking-wider">Copy Link to clipboard</p>
            </div>
          </div>
        </button>
      </div>
    </div>
  </div>

  <!-- COPIED TO CLIPBOARD TOAST -->
  <div 
    id="share-toast" 
    class="fixed bottom-10 left-1/2 -translate-x-1/2 z-50 bg-black text-white text-xs px-6 py-3 rounded-full shadow-xl flex items-center gap-2 transition-all duration-300 opacity-0 translate-y-4 pointer-events-none"
  >
    <span class="text-white">✓</span> Link copied to clipboard
  </div>

</Layout>

<script>
  function setupGalleryFeatures() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const galleryItems = document.querySelectorAll('.gallery-item');

    // 1. CATEGORY FILTER LOGIC
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Reset all buttons to inactive state
        filterBtns.forEach((b) => {
          b.classList.remove('bg-black', 'text-white', 'font-semibold');
          b.classList.add('bg-gray-100', 'text-gray-600', 'font-medium');
        });

        // Set active button style
        btn.classList.add('bg-black', 'text-white', 'font-semibold');
        btn.classList.remove('bg-gray-100', 'text-gray-600', 'font-medium');

        // Show/hide grid items based on category
        galleryItems.forEach((item) => {
          const itemCategory = item.getAttribute('data-category');
          if (filter === 'all' || itemCategory === filter) {
            (item as HTMLElement).style.display = 'block';
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    // 2. LIGHTBOX ENLARGE LOGIC
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxClose = document.getElementById('lightbox-close');

    galleryItems.forEach((item) => {
      item.addEventListener('click', () => {
        const img = item.querySelector('img');
        if (img && lightbox && lightboxImg) {
          lightboxImg.src = img.src;
          lightbox.classList.remove('hidden');
          setTimeout(() => {
            lightbox.classList.remove('opacity-0');
            lightboxImg.classList.remove('scale-95');
          }, 10);
        }
      });
    });

    function closeLightbox() {
      if (lightbox && lightboxImg) {
        lightbox.classList.add('opacity-0');
        lightboxImg.classList.add('scale-95');
        setTimeout(() => {
          lightbox.classList.add('hidden');
          lightboxImg.src = '';
        }, 300);
      }
    }

    lightboxClose?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    // 3. CONTACT / MENU MODAL LOGIC
    const contactModal = document.getElementById('contact-modal');
    const contactCard = document.getElementById('contact-modal-card');
    const openContactBtn = document.getElementById('open-contact-modal');
    const closeContactBtn = document.getElementById('close-contact-modal');

    function openContactModal() {
      if (contactModal && contactCard) {
        contactModal.classList.remove('opacity-0', 'pointer-events-none');
        if (window.innerWidth < 768) {
          contactCard.classList.remove('translate-y-full');
        } else {
          contactCard.classList.remove('scale-95', 'opacity-0');
          contactCard.classList.add('scale-100', 'opacity-100');
        }
      }
    }

    function closeContactModal() {
      if (contactModal && contactCard) {
        contactModal.classList.add('opacity-0', 'pointer-events-none');
        if (window.innerWidth < 768) {
          contactCard.classList.add('translate-y-full');
        } else {
          contactCard.classList.add('scale-95', 'opacity-0');
          contactCard.classList.remove('scale-100', 'opacity-100');
        }
      }
    }

    openContactBtn?.addEventListener('click', openContactModal);
    closeContactBtn?.addEventListener('click', closeContactModal);
    contactModal?.addEventListener('click', (e) => {
      if (e.target === contactModal) closeContactModal();
    });

    // 4. SHARE LOGIC
    const shareBtn = document.getElementById('share-btn');
    const toast = document.getElementById('share-toast');

    shareBtn?.addEventListener('click', async () => {
      const shareData = {
        title: "Karl's Gallery",
        text: "Check out Karl's Gallery photography portfolio!",
        url: window.location.href,
      };

      if (navigator.share) {
        try {
          await navigator.share(shareData);
        } catch (err) {}
      } else {
        try {
          await navigator.clipboard.writeText(window.location.href);
          if (toast) {
            toast.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
            setTimeout(() => {
              toast.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
            }, 2500);
          }
        } catch (err) {
          alert('Link copied: ' + window.location.href);
        }
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeLightbox();
        closeContactModal();
      }
    });
  }

  setupGalleryFeatures();
  document.addEventListener('astro:page-load', setupGalleryFeatures);
</script>